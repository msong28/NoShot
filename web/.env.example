# Copy to .env (gitignored). Same Supabase project as the Expo app
# (noshot-dev, ref tckpbwvzxxovnsvdtwee) -- these are the Vite-prefixed
# equivalents of EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY.
# The anon key is safe client-side by design; RLS protects the data, not
# secrecy of this key. Never put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Native (Capacitor) Google sign-in only -- from the same Google Cloud
# project Milestone 2 already set up for the Expo app's Google OAuth.
# VITE_GOOGLE_IOS_CLIENT_ID: the iOS OAuth client ID (Google Cloud Console
#   -> Credentials -> OAuth 2.0 Client IDs -> iOS).
# VITE_GOOGLE_WEB_CLIENT_ID: the Web application OAuth client ID (used as
#   the token audience -- required even though this is a native app).
# Both are public client identifiers, not secrets -- safe to ship in the
# client bundle, same as the Supabase anon key above.
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=

# Native (Capacitor) push notifications via OneSignal. Create a free
# OneSignal app (onesignal.com), add an iOS platform to it using an APNs
# Auth Key (.p8) generated in the Apple Developer portal, then copy the
# OneSignal App ID here. This is a public app identifier, not a secret --
# the OneSignal REST API key that actually *sends* pushes lives only in
# the Supabase Edge Function's own secrets, never in this file.
VITE_ONESIGNAL_APP_ID=
