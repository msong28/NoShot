# Copy this file to .env and fill in real values. Never commit .env.
# All client-side vars must be prefixed EXPO_PUBLIC_ to be embedded in the app bundle.
# Only put values here that are safe to ship inside the client — the Supabase anon
# key is safe by design (RLS is what protects data, not secrecy of this key).
# The Supabase service-role key must NEVER appear in this file or anywhere in the
# Expo app; it belongs only in server-side contexts (e.g. a CI secret).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
